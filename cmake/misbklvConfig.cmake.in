@PACKAGE_INIT@

# libmisbklv package config.
#   find_package(misbklv)                  -> misbklv::misbklv  (KLV core)
#   find_package(misbklv COMPONENTS gst)   -> misbklv::gst      (KlvStream/KlvSink)
# The gst facade is an opt-in component so core-only consumers don't inherit the
# gstreamer dependency.
include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/misbklvCoreTargets.cmake")

set(_misbklv_has_gst @MISBKLV_HAS_GST@)
if("gst" IN_LIST misbklv_FIND_COMPONENTS)
  if(NOT _misbklv_has_gst)
    set(misbklv_gst_FOUND FALSE)
    set(misbklv_FOUND FALSE)
    set(misbklv_NOT_FOUND_MESSAGE "misbklv was installed without the 'gst' component")
    return()
  endif()
  # Recreate the transitive targets the exported misbklv::gst links, so its link
  # interface resolves in the consumer.
  find_dependency(Threads)
  find_dependency(PkgConfig)
  pkg_check_modules(GST REQUIRED IMPORTED_TARGET
    gstreamer-1.0 gstreamer-app-1.0 gstreamer-codecparsers-1.0)
  include("${CMAKE_CURRENT_LIST_DIR}/misbklvGstTargets.cmake")
  set(misbklv_gst_FOUND TRUE)
endif()

check_required_components(misbklv)
