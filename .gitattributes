# Normalize line endings: store as LF in the repo, check out native.
* text=auto

# Git LFS — track large binary assets, keep text/source in regular git.
# Text extracts (.txt) next to standards stay in regular git so they're greppable/diffable.

# Standards / reference documents
*.pdf filter=lfs diff=lfs merge=lfs -text

# Media files are developer-provided and ignored under data/. Project-owned
# regression fixtures are small enough to remain in regular Git.
test/fixtures/synthetic-*.klv -filter -diff -merge -text
test/fixtures/synthetic-*.ts  -filter -diff -merge -text

# Built artifacts that shouldn't pollute diffs
*.o    filter=lfs diff=lfs merge=lfs -text
*.a    filter=lfs diff=lfs merge=lfs -text
*.so   filter=lfs diff=lfs merge=lfs -text
